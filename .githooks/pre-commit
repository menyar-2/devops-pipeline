#!/bin/bash

echo "======================================"
echo " TALISMAN PRE-COMMIT SECURITY SCAN"
echo "======================================"

talisman --githook pre-commit

STATUS=$?

if [ "$STATUS" -ne 0 ]; then
    echo
    echo "======================================"
    echo "COMMIT BLOCKED BY TALISMAN"
    echo "Sensitive data or security issue detected."
    echo "======================================"
    exit 1
fi

echo
echo "======================================"
echo "TALISMAN CHECK PASSED"
echo "Commit authorized."
echo "======================================"

exit 0
